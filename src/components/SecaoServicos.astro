---
import { getCollection } from 'astro:content'
import type { IdDivisao } from '@/content.config'

interface Props {
  divisao: IdDivisao
  titulo: string
  /** Id do heading, para o aria-labelledby da secao. */
  id: string
  descricao?: string
}

const { divisao, titulo, id, descricao } = Astro.props

const servicos = (await getCollection('servicos', ({ data }) => data.divisao === divisao)).sort(
  (a, b) => a.data.ordem - b.data.ordem
)
---

<section class="bg-canvas py-16" aria-labelledby={id}>
  <div class="mx-auto w-full max-w-wrap px-5">
    <h2 id={id} class="text-secao text-ink">{titulo}</h2>
    {descricao && <p class="mt-3 max-w-[68ch] text-ink-soft">{descricao}</p>}

    <ul class="mt-8 grid list-none gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        servicos.map((servico) => (
          <li class="rounded-xl border border-line bg-white p-6 shadow-card">
            <h3 class="text-cartao text-ink">{servico.data.titulo}</h3>
            <p class="mt-2 text-corpo text-ink-soft">{servico.data.descricao}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
