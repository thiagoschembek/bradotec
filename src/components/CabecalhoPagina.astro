---
interface Props {
  titulo: string
  subtitulo?: string
  trilha: readonly { nome: string; href: string }[]
}
const { titulo, subtitulo, trilha } = Astro.props
const atual = trilha[trilha.length - 1]
---

<section class="bg-gradient-to-b from-navy-900 to-navy-800 py-12 text-white">
  <div class="mx-auto w-full max-w-[820px] px-5">
    <nav class="mb-4 text-rotulo text-[#8fa3b8]" aria-label="Você está em">
      {
        trilha.slice(0, -1).map((item) => (
          <>
            <a class="text-[#b9c9da] no-underline hover:underline" href={item.href}>
              {item.nome}
            </a>
            <span aria-hidden="true"> › </span>
          </>
        ))
      }
      <span>{atual?.nome}</span>
    </nav>

    <h1 class="text-[clamp(1.85rem,4.4vw,2.9rem)] text-white">{titulo}</h1>
    {subtitulo && <p class="mt-2 text-cartao text-[#b9c9da]">{subtitulo}</p>}
    <slot />
  </div>
</section>
