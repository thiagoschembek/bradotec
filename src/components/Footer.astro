---
import { Image } from 'astro:assets'
import logo from '@/assets/logo-small.png'
import DadoCliente from '@/components/DadoCliente.astro'
import { navegacaoRodape } from '@/config/navegacao'
import { ehPlaceholder, site } from '@/config/site'
import { linkWhatsapp } from '@/config/whatsapp'

const ano = new Date().getFullYear()
const hrefWhatsapp = linkWhatsapp('padrao')
const hrefTelefone = ehPlaceholder(site.telefone)
  ? '/contato'
  : `tel:${site.telefone.replace(/\D/g, '')}`
const hrefEmail = ehPlaceholder(site.email) ? '/contato' : `mailto:${site.email}`
---

<footer class="bg-navy-950 px-0 pb-6 pt-14 text-[0.94rem] text-[#93a7bc]">
  <div class="mx-auto w-full max-w-wrap px-5">
    <div class="grid gap-9 md:grid-cols-[1.4fr_1fr_1fr_1.1fr]">
      <div>
        <Image src={logo} alt={site.nome} width={61} height={52} loading="lazy" class="mb-3.5 h-[52px] w-auto" />
        <p class="max-w-[34ch] text-[0.92rem] text-[#8298af]">
          Gestão documental, regularização, licenciamento e segurança contra incêndio para
          empresas, condomínios e frotas em {site.cidade} e região.
        </p>
      </div>

      {
        navegacaoRodape.map((coluna) => (
          <div>
            <h4 class="mb-3.5 text-[0.98rem] font-bold text-white">{coluna.titulo}</h4>
            <ul>
              {coluna.itens.map((item) => (
                <li class="py-1">
                  <a class="text-[#a9bccf] no-underline hover:text-white hover:underline" href={item.href}>
                    {item.rotulo}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h4 class="mb-3.5 text-[0.98rem] font-bold text-white">Atendimento</h4>
        <ul>
          <li class="py-1">
            <a
              class="text-[#a9bccf] no-underline hover:text-white hover:underline"
              href={hrefWhatsapp ?? '/contato'}
              {...hrefWhatsapp ? { target: '_blank', rel: 'noopener' } : {}}
            >
              WhatsApp comercial
            </a>
          </li>
          <li class="py-1">
            <a class="text-[#a9bccf] no-underline hover:text-white hover:underline" href={hrefTelefone}>
              <DadoCliente valor={site.telefone} />
            </a>
          </li>
          <li class="py-1">
            <a class="text-[#a9bccf] no-underline hover:text-white hover:underline" href={hrefEmail}>
              <DadoCliente valor={site.email} />
            </a>
          </li>
          <li class="py-1"><DadoCliente valor={site.endereco} /></li>
          <li class="py-1">{site.cidade} — Paraíba</li>
          <li class="py-1"><DadoCliente valor={site.horario} /></li>
          <li class="py-1"><DadoCliente valor={site.instagram} /></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-9 flex flex-wrap justify-between gap-x-6 gap-y-2.5 border-t border-white/10 pt-5 text-[0.85rem] text-[#71889f]"
    >
      <span>
        © {ano} {site.nome} — CNPJ <DadoCliente valor={site.cnpj} />. Todos os direitos reservados.
      </span>
      <span>
        A {site.nome} atua na gestão e no acompanhamento administrativo dos processos. Projetos,
        laudos e serviços técnicos são executados por profissionais e empresas legalmente
        habilitados.
      </span>
    </div>
  </div>
</footer>
