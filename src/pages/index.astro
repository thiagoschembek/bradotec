---
import { getCollection } from 'astro:content'
import BotaoLink from '@/components/BotaoLink.astro'
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import CartaoDivisao from '@/components/CartaoDivisao.astro'
import Faq from '@/components/Faq.astro'
import Kicker from '@/components/Kicker.astro'
import PainelVencimentos from '@/components/PainelVencimentos.astro'
import { site } from '@/config/site'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const titulo = `${site.nome} — Regularização, licenças e segurança contra incêndio em ${site.cidade} (${site.estado})`

const schemaFaq = await schemaFaqDaPagina('home')

const caminhos = (await getCollection('caminhos')).sort((a, b) => a.data.ordem - b.data.ordem)
const divisoes = (await getCollection('divisoes')).sort((a, b) => a.data.ordem - b.data.ordem)
const servicos = (await getCollection('servicos')).sort((a, b) => a.data.ordem - b.data.ordem)

const titulosDaDivisao = (idDivisao: string) =>
  servicos.filter(({ data }) => data.divisao === idDivisao).map(({ data }) => data.titulo)

const provas = [
  'Segurança contra incêndio e pânico',
  'Empresas, condomínios e instituições',
  'Acompanhamento de processo do início ao fim',
] as const

/**
 * Diferenciais. Todos verificaveis: dizem o que a empresa faz, nao quanto ela
 * e boa. Numero de clientes e nota do Google ficam de fora enquanto forem
 * placeholder — a prova social so aparece quando for real.
 */
const diferenciais = [
  {
    titulo: 'Base em João Pessoa',
    descricao: 'Atendimento presencial na capital e na região metropolitana da Paraíba.',
  },
  {
    titulo: 'Processo acompanhado',
    descricao: 'Do protocolo à conclusão, com retorno sobre cada etapa e cada exigência.',
  },
  {
    titulo: 'Profissionais habilitados',
    descricao: 'Projetos e laudos executados por quem tem habilitação legal para assinar.',
  },
  {
    titulo: 'Retorno direto',
    descricao: 'O atendimento é feito por quem vai conduzir o processo, não por central.',
  },
] as const
---

<BaseLayout titulo={titulo} schemasExtras={schemaFaq ? [schemaFaq] : []}>
  <section
    class="overflow-hidden bg-navy-900 bg-[radial-gradient(900px_480px_at_85%_-10%,rgba(210,43,38,0.2),transparent_62%)] py-16 text-white lg:py-24"
  >
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="grid items-center gap-11 lg:grid-cols-[1.08fr_0.92fr] lg:gap-14">
        <div>
          <span
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 py-2 pl-3 pr-4 text-apoio font-semibold text-[#dce7f2]"
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"></path>
              <circle cx="12" cy="10" r="2.6"></circle>
            </svg>
            {site.regiaoAtendida}
          </span>

          <h1 class="mb-5 text-[clamp(2rem,5.2vw,3.35rem)] tracking-[-0.03em] text-white">
            Regularização, licenças e documentação sem complicação.
          </h1>

          <p class="max-w-[56ch] text-guia text-[#b9c9da]">
            Em {site.cidade} e região, a {site.nome} cuida dos processos documentais da sua empresa,
            condomínio, imóvel e veículo — reunindo gestão, acompanhamento e profissionais
            especializados para você ter mais segurança e menos burocracia.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <BotaoWhatsapp origem="orcamento">Solicitar orçamento</BotaoWhatsapp>
            <BotaoLink href="/diagnostico" variante="sobreEscuro">
              Responder as 4 perguntas
            </BotaoLink>
          </div>

          <ul
            class="mt-8 flex flex-wrap gap-x-7 gap-y-2.5 border-t border-white/15 pt-6 text-corpo text-[#a7bacd]"
          >
            {
              provas.map((prova) => (
                <li class="flex items-center gap-2">
                  <svg
                    width="17"
                    height="17"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="shrink-0 text-[#7fd1a6]"
                  >
                    <path d="m4 12.5 5 5L20 6.5" />
                  </svg>
                  {prova}
                </li>
              ))
            }
          </ul>
        </div>

        <PainelVencimentos />
      </div>
    </div>
  </section>

  <section class="bg-canvas py-16" aria-labelledby="caminhos">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker>Comece por aqui</Kicker>
      <h2 id="caminhos" class="mt-2 text-secao text-ink">O que você precisa resolver?</h2>
      <p class="mt-3 max-w-[64ch] text-ink-soft">
        Escolha a situação mais parecida com a sua. Cada caminho leva direto à solução
        correspondente.
      </p>

      <ul class="mt-8 grid list-none gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          caminhos.map((caminho) => (
            <li>
              <a
                class="group flex h-full flex-col rounded-xl border border-line bg-white p-5 no-underline shadow-card transition-colors hover:border-navy-900"
                href={caminho.data.href}
              >
                <span class="text-cartao text-ink group-hover:text-fire">
                  {caminho.data.titulo}
                </span>
                <span class="mt-2 text-corpo text-ink-soft">{caminho.data.descricao}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="py-16" aria-labelledby="divisoes">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker>Três divisões, uma só empresa</Kicker>
      <h2 id="divisoes" class="mt-2 text-secao text-ink">Uma central de soluções documentais</h2>
      <p class="mt-3 max-w-[68ch] text-ink-soft">
        A {site.nome} organiza o que costuma estar espalhado entre contador, síndico, engenheiro e
        despachante. Você trata com uma equipe só — e ela coordena o resto.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          divisoes.map((divisao) => (
            <CartaoDivisao
              marca={divisao.data.marca}
              titulo={divisao.data.titulo}
              resumo={divisao.data.resumo}
              href={divisao.data.href}
              cor={divisao.data.cor}
              origemWhatsapp={divisao.data.origemWhatsapp}
              servicos={titulosDaDivisao(divisao.id)}
            />
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <BotaoLink href="/solucoes">Comparar as três divisões</BotaoLink>
        <BotaoLink href="/diagnostico" variante="escuro">Não sei qual é o meu caso</BotaoLink>
      </div>
    </div>
  </section>

  <section class="bg-navy-900 py-16 text-white" aria-labelledby="como-atuamos">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="como-atuamos" class="max-w-[24ch] text-secao text-white">
        O que você pode esperar da Bradotec
      </h2>

      <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          diferenciais.map((item) => (
            <div class="border-t border-white/15 pt-5">
              <dt class="text-cartao text-white">{item.titulo}</dt>
              <dd class="mt-2 text-corpo text-[#b9c9da]">{item.descricao}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Faq pagina="home" />
</BaseLayout>
