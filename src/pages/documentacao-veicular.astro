---
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import CabecalhoPagina from '@/components/CabecalhoPagina.astro'
import Faq from '@/components/Faq.astro'
import SecaoServicos from '@/components/SecaoServicos.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Documentação veicular', href: '/documentacao-veicular' },
] as const

const schemaFaq = await schemaFaqDaPagina('documentacao-veicular')

/** Venda cruzada: quem chega pela frota costuma ter licenca e incendio pendentes. */
const outrasFrentes = [
  { titulo: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { titulo: 'Licenças e regularização', href: '/regularizacoes' },
] as const
---

<BaseLayout
  titulo="Documentação veicular e gestão de frotas em João Pessoa (PB) | Bradotec Auto"
  descricao="Transferência, emplacamento, primeiro registro, segunda via, alteração de dados e regularização de pendências em João Pessoa/PB — e gestão da documentação de frotas para empresas."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    titulo="Documentação veicular e frotas"
    subtitulo="Transferência, emplacamento, segunda via e regularização de pendências em João Pessoa — e, para empresas, a documentação da frota inteira sob controle."
    trilha={trilha}
  >
    <div class="mt-6 flex flex-wrap gap-3">
      <BotaoWhatsapp origem="veicular">Resolver documentação do meu veículo</BotaoWhatsapp>
      <BotaoWhatsapp origem="frota" variante="sobreEscuro">Tenho uma frota</BotaoWhatsapp>
    </div>
  </CabecalhoPagina>

  <section class="py-14" aria-labelledby="intro-auto">
    <div class="mx-auto w-full max-w-wrap px-5">
      <p class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-div-auto">Bradotec Auto</p>
      <h2 id="intro-auto" class="mt-2 text-[1.6rem] text-ink">Processos do veículo, conduzidos</h2>
      <p class="mt-3 max-w-[72ch] text-ink-soft">
        Cada processo tem etapas próprias e pendências que só aparecem no meio do caminho. A
        Bradotec conduz do início ao fim e informa o andamento a cada etapa.
      </p>
    </div>
  </section>

  <SecaoServicos divisao="auto" id="servicos-auto" titulo="Serviços da divisão Auto" />

  <section class="bg-navy-900 py-16 text-white" aria-labelledby="para-empresas">
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <p class="text-[0.82rem] font-bold uppercase tracking-[0.08em] text-[#8fd4da]">
            Para empresas
          </p>
          <h2 id="para-empresas" class="mt-2 max-w-[24ch] text-[1.65rem] text-white">
            Frota com documentação organizada
          </h2>
          <p class="mt-3 max-w-[68ch] text-[#b9c9da]">
            Quando a empresa tem vários veículos, o problema deixa de ser cada processo e passa a
            ser o controle: quem vence quando, o que está pendente, qual veículo não pode rodar. A
            Bradotec centraliza isso junto com a documentação da empresa.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <BotaoWhatsapp origem="frota">Falar sobre gestão de frota</BotaoWhatsapp>
            <a
              class="inline-flex min-h-[50px] items-center justify-center rounded-[11px] border border-white/30 bg-white/10 px-6 py-3.5 font-bold text-white no-underline transition-colors hover:bg-white/20"
              href="/empresas"
            >
              Ver soluções para empresas
            </a>
          </div>
        </div>

        <div class="rounded-xl border border-white/12 bg-white/5 p-7">
          <h3 class="text-[1.1rem] text-white">Também cuidamos do resto da empresa</h3>
          <p class="mt-3 text-[0.97rem] text-[#b9c9da]">
            Muita empresa procura a Bradotec pela frota e descobre que licenças e segurança contra
            incêndio também estão pendentes. Como é tudo na mesma casa, dá para resolver junto, com
            um só interlocutor.
          </p>
          <ul class="mt-5 flex list-none flex-col gap-2.5">
            {
              outrasFrentes.map((frente) => (
                <li>
                  <a
                    class="font-bold text-white underline underline-offset-4 hover:text-[#8fd4da]"
                    href={frente.href}
                  >
                    {frente.titulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <Faq pagina="documentacao-veicular" />
</BaseLayout>
