---
import { getCollection } from 'astro:content'
import AvisoEscopo from '@/components/AvisoEscopo.astro'
import BotaoLink from '@/components/BotaoLink.astro'
import BotaoWhatsapp from '@/components/BotaoWhatsapp.astro'
import CabecalhoPagina from '@/components/CabecalhoPagina.astro'
import Faq from '@/components/Faq.astro'
import Kicker from '@/components/Kicker.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { schemaFaqDaPagina } from '@/lib/faq'

const trilha = [
  { nome: 'Início', href: '/' },
  { nome: 'Segurança contra incêndio', href: '/seguranca-contra-incendio' },
  { nome: 'AVCB', href: '/avcb' },
] as const

const schemaFaq = await schemaFaqDaPagina('avcb')

const conteudo = await getCollection('avcb')
const doGrupo = (grupo: 'risco' | 'item' | 'cotacao') =>
  conteudo.filter(({ data }) => data.grupo === grupo).sort((a, b) => a.data.ordem - b.data.ordem)

const riscos = doGrupo('risco')
const itens = doGrupo('item')
const cotacao = doGrupo('cotacao')
---

<BaseLayout
  titulo="AVCB: o que é, para que serve e o que é exigido | Bradotec João Pessoa"
  descricao="O que é o AVCB, por que ele é obrigatório, o que costuma ser exigido para obtê-lo e o que está em jogo quando vence — para condomínios, comércios, indústrias e postos de combustível em João Pessoa e região."
  trilha={trilha}
  schemasExtras={schemaFaq ? [schemaFaq] : []}
>
  <CabecalhoPagina
    titulo="AVCB: o que é, para que serve e o que costuma ser exigido"
    subtitulo="O documento que atesta que a edificação está em conformidade com as normas de segurança contra incêndio — e o que acontece quando ele vence."
    trilha={trilha}
  >
    <div class="mt-6 flex flex-wrap gap-3">
      <BotaoWhatsapp origem="avcb">Falar sobre o AVCB</BotaoWhatsapp>
      <BotaoLink href="/diagnostico" variante="sobreEscuro">Solicitar diagnóstico</BotaoLink>
    </div>
  </CabecalhoPagina>

  <section class="py-20 lg:py-24" aria-labelledby="o-que-e">
    <div class="mx-auto w-full max-w-wrap px-5">
      <Kicker>Bradotec Fire</Kicker>
      <h2 id="o-que-e" class="mt-2 max-w-[20ch] text-secao text-ink">O que é o AVCB</h2>

      <div class="mt-6 max-w-[68ch] space-y-5 text-guia text-ink-soft">
        <p>
          AVCB é a sigla de <strong class="font-bold text-ink">
            Auto de Vistoria do Corpo de Bombeiros
          </strong>. É o documento emitido pelo Corpo de Bombeiros atestando que a edificação está
          em conformidade com as normas, regras e leis de segurança, prevenção e combate a
          incêndios.
        </p>
        <p>
          Ele é emitido depois de uma vistoria feita pela corporação. A vistoria pode acontecer a
          pedido do próprio condomínio ou da empresa, por denúncia, ou como fiscalização sem aviso
          prévio. Em algumas situações e tipos de edificação, o documento equivalente tem outro
          nome e outro rito — o que se aplica ao seu caso depende da ocupação, da área e do risco.
        </p>
        <p>
          O AVCB é obrigatório. Não é um selo de qualidade nem um diferencial: é a condição para a
          edificação estar regular.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-900 py-20 text-white lg:py-28" aria-labelledby="em-jogo">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="em-jogo" class="max-w-[24ch] text-secao text-white">
        O que está em jogo quando o AVCB vence
      </h2>
      <p class="mt-4 max-w-[66ch] text-guia text-[#b9c9da]">
        A multa costuma ser a primeira coisa que vem à cabeça, e é a menor delas. O que pesa mais
        aparece depois — e quase sempre no pior momento.
      </p>

      <dl class="mt-12 grid gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
        {
          riscos.map((risco) => (
            <div class="relative border-t border-white/15 pt-7">
              <span
                class="absolute -top-0.5 left-0 h-[3px] w-9 rounded-full bg-fire"
                aria-hidden="true"
              />
              <dt class="text-cartao-lg text-white">{risco.data.titulo}</dt>
              <dd class="mt-3 text-corpo text-[#b9c9da]">{risco.data.descricao}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 flex flex-wrap gap-3">
        <BotaoWhatsapp origem="avcb">Quero resolver o AVCB</BotaoWhatsapp>
        <BotaoLink href="/seguranca-contra-incendio" variante="sobreEscuro">
          Ver a divisão Fire
        </BotaoLink>
      </div>
    </div>
  </section>

  <section class="bg-canvas py-20 lg:py-24" aria-labelledby="exigido">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="exigido" class="max-w-[22ch] text-secao text-ink">O que costuma ser exigido</h2>
      <p class="mt-4 max-w-[66ch] text-guia text-ink-soft">
        A lista abaixo é o que aparece com mais frequência. A lista definitiva do seu caso sai da
        análise da edificação — depende da ocupação, da área, do risco e do que o órgão competente
        exigir para aquele tipo de imóvel.
      </p>

      <ul class="mt-11 grid list-none gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          itens.map((item) => (
            <li class="rounded-xl border border-line bg-white p-5 shadow-card">
              <p class="text-cartao font-bold text-ink">{item.data.titulo}</p>
              <p class="mt-2 text-corpo text-ink-soft">{item.data.descricao}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!--
    Bloco deliberado. O texto de referencia que originou esta pagina trazia
    prazo de renovacao e valor de multa de Sao Paulo, Minas, Rio e Santa
    Catarina. Copiar esses numeros para um site de Joao Pessoa seria informar
    errado: os dois sao definidos por legislacao estadual. Dizer isso, em vez
    de repetir o numero de outro estado, e o que separa quem conhece o assunto
    de quem copiou um texto da internet.
  -->
  <section class="py-20 lg:py-24" aria-labelledby="prazo-multa">
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="max-w-[70ch] rounded-xl border-l-4 border-l-fire border-y border-r border-line bg-white p-7 shadow-card">
        <h2 id="prazo-multa" class="text-cartao-lg text-ink">
          Sobre prazo de validade e valor de multa
        </h2>
        <div class="mt-4 space-y-4 text-ink-soft">
          <p>
            Os dois são definidos pela legislação de cada estado e variam bastante entre eles. Um
            mesmo tipo de condomínio pode ter validade de três anos em um estado e cinco em outro,
            e o teto da multa não é o mesmo em lugar nenhum.
          </p>
          <p>
            Por isso esta página não repete número de outro estado. O prazo e o valor que valem
            para a sua edificação são os da legislação aplicável na Paraíba e ao seu tipo de
            ocupação — e é isso que a Bradotec levanta no início do processo, antes de qualquer
            orçamento.
          </p>
          <p class="font-semibold text-ink">
            Se alguém te apresentar um prazo ou um valor sem antes olhar a sua edificação,
            desconfie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-canvas py-20 lg:py-24" aria-labelledby="cotacao">
    <div class="mx-auto w-full max-w-wrap px-5">
      <h2 id="cotacao" class="max-w-[26ch] text-secao text-ink">
        O que perguntar antes de contratar
      </h2>
      <p class="mt-4 max-w-[68ch] text-guia text-ink-soft">
        Seis perguntas que separam orçamento comparável de orçamento que só parece mais barato. Use
        com qualquer fornecedor — inclusive conosco.
      </p>

      <ol class="mt-11 grid list-none gap-4 md:grid-cols-2">
        {
          cotacao.map((pergunta, indice) => (
            <li class="flex gap-4 rounded-xl border border-line bg-white p-5 shadow-card">
              <span
                class="flex size-7 shrink-0 items-center justify-center rounded-full bg-navy-900 text-rotulo font-bold text-white"
                aria-hidden="true"
              >
                {indice + 1}
              </span>
              <div>
                <p class="text-cartao font-bold text-ink">{pergunta.data.titulo}</p>
                <p class="mt-2 text-corpo text-ink-soft">{pergunta.data.descricao}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="py-20 lg:py-24" aria-labelledby="sem-projeto">
    <div class="mx-auto w-full max-w-wrap px-5">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <h2 id="sem-projeto" class="max-w-[24ch] text-secao text-ink">
            E se o projeto de incêndio se perdeu?
          </h2>
          <div class="mt-6 max-w-[62ch] space-y-4 text-ink-soft">
            <p>
              É mais comum do que parece. O projeto costuma ser elaborado quando a edificação é
              construída e se perde com as trocas de síndico, de administradora e de responsável ao
              longo dos anos. Muitas vezes ninguém sabe que ele existia.
            </p>
            <p>
              Sem projeto não há o que vistoriar. O primeiro passo, então, não é marcar vistoria: é
              levantar o que a edificação de fato possui hoje e elaborar o projeto, por profissional
              legalmente habilitado para assiná-lo.
            </p>
            <p>
              É por aí que a Bradotec começa quando o caso chega nesse estado — organizando o que
              existe antes de tocar em qualquer protocolo.
            </p>
          </div>
        </div>

        <div class="rounded-xl border border-line bg-canvas p-7">
          <p class="text-cartao-lg text-ink">Não sabe em que estágio o seu caso está?</p>
          <p class="mt-3 text-ink-soft">
            O Diagnóstico de Regularização são quatro perguntas. Ele não substitui a análise
            documental — organiza a conversa e mostra por onde começa.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <BotaoLink href="/diagnostico">Responder as 4 perguntas</BotaoLink>
            <BotaoWhatsapp origem="avcb" pequeno>Falar agora</BotaoWhatsapp>
          </div>
        </div>
      </div>
    </div>
  </section>

  <AvisoEscopo titulo="O que a Bradotec faz e o que é feito por terceiros">
    A Bradotec atua na gestão documental, na condução administrativa e no acompanhamento do
    processo junto ao órgão competente. Projeto técnico, laudos, instalação e manutenção de
    sistemas preventivos exigem habilitação específica e são executados por profissionais e
    empresas legalmente habilitados, com quem a Bradotec coordena o trabalho. Prazos de análise,
    vistoria e aprovação dependem do Corpo de Bombeiros. Esta página é informativa e não substitui
    a análise da sua edificação nem orientação jurídica.
  </AvisoEscopo>

  <Faq pagina="avcb" titulo="Perguntas frequentes sobre AVCB" />
</BaseLayout>
